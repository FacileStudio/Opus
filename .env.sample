# Copy to .env next to docker-compose.yml. Both services read it: Postgres
# takes POSTGRES_*, the Opus container takes the rest.
# Every variable is described in docs/configuration.md.

# Public URL, such as https://opus.example.com. The entrypoint derives
# OPUS_API_URL as <OPUS_CLIENT_URL>/api.
OPUS_CLIENT_URL=
# OPUS_API_URL=
# Allowed browser origins, comma-separated. Usually the same as OPUS_CLIENT_URL.
CORS_ORIGINS=

# Database. The entrypoint builds DATABASE_URL from POSTGRES_* when it is unset,
# and GO_DATABASE_URL replaces it when set.
POSTGRES_DB=opus
POSTGRES_USER=opus
POSTGRES_PASSWORD=
# DATABASE_URL=
# GO_DATABASE_URL=

# Sign-in through Registre. Without OIDC_ISSUER nobody can sign in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# <OPUS_CLIENT_URL>/api/auth/oidc/callback
OIDC_REDIRECT_URL=
# Where a completed login lands. Defaults to the first CORS origin.
# OIDC_SUCCESS_URL=
# Mounts porte's device exchange so CLI device login works here.
# OIDC_CLI_AUDIENCE=
# Delegated access for other suite apps (Bulle). OIDC_MACHINE_AUDIENCE is
# Opus's own client id in Registre.
# OIDC_MACHINE_AUDIENCE=
# OIDC_SCOPE_PREFIX=opus
# Seals stored OIDC tokens. Generate with: openssl rand -hex 32
# PORTE_TOKEN_KEY=

# MCP server at /mcp, such as https://opus.facile.studio/mcp. Needs OIDC_ISSUER.
# MCP_RESOURCE=

# Ideas page. Needs OIDC_ISSUER.
# BULLE_URL=

# Antenne event bus. No URL turns the bus off; a URL needs the secret.
# ANTENNE_URL=
# ANTENNE_SECRET=
# ANTENNE_INSTANCE_ID=
# Fallback workspace id for projects from old Sablier versions whose events carry no space.
# ANTENNE_SYNC_WORKSPACE_ID=

# GitHub webhook signature check for POST /api/integrations/github/webhook.
# GITHUB_WEBHOOK_SECRET=

# Opus GitHub App for linked repositories and the issues view. Both, or neither.
# The private key is the .pem file, base64-encoded on one line. See docs/configuration.md.
# OPUS_GITHUB_APP_CLIENT_ID=
# OPUS_GITHUB_APP_PRIVATE_KEY=

# Realtime fan-out across replicas. Empty keeps it in memory.
# REDIS_URL=

# Log shipping to Journal, when both are set.
# JOURNAL_URL=
# JOURNAL_TOKEN=

# S3 task images. All four of the first block turn it on.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=
# S3_FORCE_PATH_STYLE=true
# S3_MAX_IMAGE_UPLOAD_BYTES=10485760
# S3_PRESIGN_TTL_SECONDS=300
