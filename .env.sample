# General URLs
# OPUS_CLIENT_URL=http://localhost:5173
# OPUS_API_URL=http://localhost:1337      # optional — defaults to OPUS_CLIENT_URL/api

# Database
# DATABASE_URL=                            # optional — derived from POSTGRES_* vars if unset
POSTGRES_DB=opus
POSTGRES_USER=opus
POSTGRES_PASSWORD=

# Go backend database (the port adopts the suite's int64 ids; the legacy
# Drizzle schema is CUID2 text, so the two live on separate databases).
# Optional — derived from POSTGRES_* vars with POSTGRES_DB_GO if unset.
# GO_DATABASE_URL=postgresql://opus:password@postgres:5432/opus_go
# POSTGRES_DB_GO=opus_go

# Redis Pub/Sub for WebSockets (Optional) -> auto fallback to in memory
# Only one mode should be configured. Priority: Cluster > Sentinel > Standalone.

# Standalone
#REDIS_URL=

# Sentinel
#REDIS_SENTINELS=
#REDIS_SENTINEL_MASTER_NAME=mymaster
#REDIS_SENTINEL_PASSWORD=
#REDIS_SENTINEL_TLS=false

# Cluster
#REDIS_CLUSTER_NODES=

# Shared (Sentinel & Cluster)
#REDIS_PASSWORD=

# Authentication
# Generate with: openssl rand -hex 32
# If unset, a random secret is generated at startup (sessions won't survive restarts)
AUTH_SECRET=

# Delegated access for other suite apps (Bulle). Both need OIDC_ISSUER.
# OIDC_MACHINE_AUDIENCE is Opus's own client id in Registre's seed.
OIDC_MACHINE_AUDIENCE=
OIDC_SCOPE_PREFIX=
# facile-cli mounts the device exchange so CLI device login works here; unset leaves it 404.
OIDC_CLI_AUDIENCE=

# GitHub SSO (Sign in with GitHub — OAuth App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Legacy fallback for SSO (used only if GITHUB_OAUTH_* are unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub integration (GitHub App — repository sync, webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=

# Antenne event bus (optional). Unset URL or secret turns the bus off.
# ANTENNE_URL=
# ANTENNE_SECRET=
# ANTENNE_INSTANCE_ID=
# Fallback workspace id for projects from old Sablier versions whose events carry no space.
# ANTENNE_SYNC_WORKSPACE_ID=

# Legacy proxy auth bridge. The Go binary proxies unported /api routes to the
# TS API (apps/api-legacy). The browser holds a porte session, which the TS
# API cannot read, so the Go proxy stamps proxied requests with the verified
# user id plus an HMAC of this secret; the TS API short-circuits its own
# better-auth lookup when the tag verifies. Generate with: openssl rand -hex 32
# Unset disables the bridge and proxied routes keep their legacy 401 behavior.
# AUTH_BRIDGE_SECRET=
